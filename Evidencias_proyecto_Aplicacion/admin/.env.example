SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_anon_aqui

# Opcional: solo si usas Google Maps en el cliente
GOOGLE_MAPS_API_KEY=tu_clave_google_maps_aqui

# RPC para resolver comuna por coordenadas
SUPABASE_RPC_NAME=obtener_comuna_por_coordenadas
SUPABASE_RPC_PARAM_LAT=p_lat
SUPABASE_RPC_PARAM_LNG=p_lon
