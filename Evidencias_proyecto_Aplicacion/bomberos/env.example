# Copiar este archivo como .env en la raíz del proyecto:
#   cp env.example .env        (Linux/macOS)
#   copy env.example .env      (Windows)
#
# NUNCA subas .env al repositorio. Solo valores de ejemplo aquí.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

GOOGLE_MAPS_API_KEY=tu-google-maps-api-key-aqui

# RPC
SUPABASE_RPC_NAME=obtener_comuna_por_coordenadas

# Nombres de parámetros (según tu función: p_lon, p_lat)
SUPABASE_RPC_PARAM_LAT=p_lat
SUPABASE_RPC_PARAM_LNG=p_lon
