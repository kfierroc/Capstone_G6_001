# =============================================================================
# SECRETOS Y CREDENCIALES — revisar antes de cada commit
# Copiar env.example → .env y completar solo en tu máquina local.
# =============================================================================
.env
.env.*
**/.env
**/.env.*
*.env
!env.example
!.env.example

# Android / iOS
**/local.properties
**/key.properties
**/secrets.properties
**/google-services.json
**/GoogleService-Info.plist

# Certificados y claves privadas
**/*.keystore
**/*.jks
**/*.p12
**/*.pem
**/*.key
**/*.pfx
**/id_rsa
**/id_ed25519
**/serviceAccount*.json
**/credentials.json

# Backups que pueden contener secretos
*.bak
*.backup
*~

# =============================================================================
# Miscellaneous
# =============================================================================
*.class
*.log
*.pyc
*.swp
*.stackdump
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# =============================================================================
# Windows
# =============================================================================
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# IDEs y editores
# =============================================================================
*.iml
*.ipr
*.iws
.idea/

# VS Code: descomenta la siguiente línea para ignorar toda la carpeta
#.vscode/

# Cursor (estado local del IDE)
.cursor/

# =============================================================================
# Flutter / Dart / Pub
# =============================================================================
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# =============================================================================
